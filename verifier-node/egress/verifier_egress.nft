#!/usr/sbin/nft -f
# Defence in depth for ADR-0021 — the verifier box may open SMTP (tcp/25) ONLY to public addresses.
#
# The application guard (verifier-node/truemail-rack/app/truemail_server/wrapper/probe_guard.rb) refuses a non-public target before the
# gem connects. This ruleset is the layer that cannot be raced: the gem re-resolves the mail host inside its own SMTP step, so a DNS answer
# that flips between the guard's check and the connect (rebinding) can still reach a private address — and only the network can stop that.
#
# KEEP IN STEP WITH THE GUARD. scripts/check-probe-guard.sh fails if any range the guard refuses is missing from the sets below, and syntax-checks this
# file with `nft -c`. IPv4 is a deny-list of the special-purpose blocks; IPv6 is an ALLOW-list, exactly as in the guard: only global unicast (2000::/3) may be
# reached, minus the special-purpose blocks inside it.
#
# INSTALL (Linux, as root):  nft -f /etc/nftables.d/verifier_egress.nft   (persist via your distro's nftables.service)
# VERIFY after installing:   nft list chain inet verifier_egress output   (the counters move when something tries a refused destination)
# Cloud: mirror it in the provider's egress security group / firewall as well (deny tcp/25 to the same ranges); and restrict the instance
# metadata service independently of this file (IMDSv2, hop limit 1) — metadata is reachable on ports other than 25.
table inet verifier_egress {
  set nonpublic4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
                 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
                 224.0.0.0/4, 240.0.0.0/4 }
  }
  set nonpublic6_inside_global {
    type ipv6_addr; flags interval
    elements = { 2001::/23, 2001:db8::/32, 2002::/16, 3fff::/20 }
  }
  chain output {
    type filter hook output priority 0; policy accept;
    tcp dport 25 ip daddr @nonpublic4 counter reject with icmp type admin-prohibited
    # everything that is not global unicast: ::1, ::, ::ffff:0:0/96 (IPv4-mapped), 64:ff9b::/96 (NAT64), ULA fc00::/7, link-local, multicast, ...
    tcp dport 25 ip6 daddr != 2000::/3 counter reject with icmpv6 type admin-prohibited
    tcp dport 25 ip6 daddr @nonpublic6_inside_global counter reject with icmpv6 type admin-prohibited
  }
}
